# Copia este archivo como .env y completa los valores. NUNCA subas el .env real a GitHub.

# Conexión a PostgreSQL (formato: postgresql://usuario:clave@host:5432/basedatos)
DATABASE_URL=

# true solo si te conectas a un PostgreSQL remoto que exige SSL (por ejemplo la URL externa de Render)
DATABASE_SSL=false

# Cadena larga y aleatoria para firmar las sesiones (mínimo 32 caracteres)
SESSION_SECRET=

# Duración de la sesión en horas (opcional, por defecto 8)
SESSION_HOURS=8

# Si es true, al arrancar crea las tablas y carga los datos de ejemplo cuando la base está vacía
AUTO_INIT_DB=true

# Puerto local (Render lo define automáticamente)
PORT=3000

# development | production
NODE_ENV=development
